# Copy this file to env.sh and edit it:   cp env.sh.example env.sh
# start.sh and demo-data/run_demo_setup.sh load env.sh automatically if it exists.
# env.sh is git-ignored, so your connection details stay on your machine.
export PGDATABASE=postgres PGUSER=postgres PGHOST=localhost PGPORT=5432
# export PGPASSWORD=...   # only if your server asks for one; or use ~/.pgpass instead
